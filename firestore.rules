rules_version = '2';

// CB TA TRADING Org Chart — Firestore Security Rules
//
// Permission model:
//   - admin   = read/write everything; can manage user roles
//   - editor  = read/write org data; cannot change roles
//   - viewer  = read-only
//   - pending = signed up but not yet approved by an admin — cannot read org data
//   - guest   = (unauthenticated) — NO access
//
// Paste this entire file into:
//   Firebase Console → Firestore Database → Rules tab → Publish

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function canEdit() {
      return isSignedIn() && (userRole() == 'admin' || userRole() == 'editor');
    }

    // Approved = role exists and isn't 'pending'
    function isApproved() {
      return isSignedIn() && userRole() in ['admin', 'editor', 'viewer'];
    }

    // ── users/{uid} — one doc per signed-in user with their role ─────
    match /users/{userId} {
      // Read: own doc or any admin
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Create: only on first sign-in (own uid, email matches auth token).
      // auth.jsx writes 'admin' for whitelisted emails, 'pending' for everyone
      // else — the latter must be approved by an admin before they can read
      // org data.
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['admin', 'editor', 'viewer', 'pending'];

      // Update: admin only (so viewers/pending users can't self-promote).
      // EXCEPTION: own user may update their own displayName (but not role).
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email);

      // Delete: admin only
      allow delete: if isAdmin();
    }

    // ── orgs/{orgId} — shared org chart data ────────────────────────
    // Pending users are signed in but NOT approved → no read access.
    match /orgs/{orgId} {
      allow read:  if isApproved();
      allow write: if canEdit();
    }

    // ── Everything else: deny by default ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
